# Copy to .env and fill in. Never commit the real file.
#
# This app looks for .env in its own folder first, then one level above it,
# so the teaching staff's .env in the parent submissions folder is found
# automatically.

# The course key. gpt-6-luna only.
PORTKEY_API_KEY=your-key-here

# Alternative: your own OpenAI key, if you are not using the course gateway.
# OPENAI_API_KEY=your-key-here

# Optional. USD per 1,000,000 tokens, for the cost column in the dashboard.
# Left unset, the app reports exact token counts and marks cost as unpriced
# rather than inventing a rate.
# MODEL_PRICE_IN=
# MODEL_PRICE_CACHED_IN=
# MODEL_PRICE_OUT=
